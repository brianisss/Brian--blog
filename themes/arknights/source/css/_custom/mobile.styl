/* ========================================
   BA 風格手機版優化
   適用：768px 以下裝置
   ======================================== */

/* 手機版導航按鈕優化 */
@media ( max-width 768px )
  .navBtn
    top 0.5em
    left 0.5em
    font-size 1.5em
    width 30px
    height 22px
    
  .navBtnIconBar
    height 0.08em
    
  /* 底部按鈕容器優化 */
  .bottom-btn
    display flex
    justify-content space-between
    align-items center
    padding 8px 10px
    gap 8px
    
    a
      padding 6px 10px
      font-size 12px
      
  /* 側邊欄手機版優化 */
  aside
    padding 10px 8px
    max-width 100%
    
    h1
      font-size 1.1em
      
    #logo
      height 3px
      
  /* 文章內容手機版優化 */
  article
    padding 10px 8px
    
    h1, h2, h3
      font-size 1.2em
      
    p
      line-height 1.5
      margin 0.8em 0
      
  /* 圖片響應式 */
  img
    max-width 100%
    height auto
    display block
    margin 8px auto
    
  /* 表格手機版優化 */
  table
    display block
    overflow-x auto
    width 100%
    white-space nowrap
    
  /* 代碼塊手機版優化 */
  pre
    overflow-x auto
    width 100%
    padding 10px
    
  /* 連結手機版優化 */
  a
    padding 0 1px
    
  /* 按鈕手機版優化 */
  button
    padding 6px 10px
    font-size 12px
    
  /* 列表手機版優化 */
  li
    margin-block-start 0.3em
    margin-block-end 0.3em
    
  /* 區塊引用手機版優化 */
  blockquote
    margin 0.8em 0
    padding 8px 12px
    border-left-width 3px
    
  /* 標題手機版優化 */
  h1, h2, h3, h4, h5, h6
    margin-block-start 0.5em
    margin-block-end 0.3em
    padding-top 0.3em
    padding-bottom 0.3em
    
  /* 列表手機版優化 */
  .task-list
    padding-left 0.5em
    
  /* 表單手機版優化 */
  input, select, textarea
    font-size 16px  /* 防止 iPhone 縮放 */
    
  /* 彈出層手機版優化 */
  .search-popup
    width 95%
    max-width 320px
    
  /* 分頁手機版優化 */
  #paginator
    padding 8px 0
    
  .page-number
    padding 6px 10px
    font-size 12px
    
  /* 導航項目手機版優化 */
  .navItemTitle
    font-size 12px
    
  /* 導航列表手機版優化 */
  .navContent
    font-size 12px
