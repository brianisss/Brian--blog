:root[theme-mode=dark]
  --cursor-data var(--dark-cursor)
  --body-background var(--dark-background)

  --theme-highlight #2b8fff
  --theme-subcolor #ffd84d
  --theme-stress #ff5c7a

  --theme-bar-color-0 #2b8fff
  --theme-bar-color-1 #2b8ffc
  --theme-bar-color-2 #2b8f
  --theme-bar-color-3 #2b8f6

  --theme-kbd-shadow #d9a800
  --theme-kbd-text #333

  --theme-cursor #ccc
  --theme-cursor-bg #fff8

  --theme-text-hover #000

  --theme-text #c4c4c4
  --theme-text-light #fff
  --theme-text-rev #000

  --theme-background #0d1b2a
  --theme-bg-trans0 rgba(13, 27, 42, 0.95)
  --theme-bg-trans1 rgba(13, 27, 42, 0.8)
  --theme-bg-trans2 rgba(30, 58, 95, 0.8)
  --theme-bg-hover #1a2d47

  --theme-bg-light #fff
  --theme-bg-soft rgba(#fff, .05)
  --theme-bg-soft-hover rgba(#fff, .1)

  --theme-ex-header rgba(#fff, .3)

  --theme-btn-bg #2b8fff

  --theme-border #2b8fff
  --theme-border-light #fff
  --theme-border-soft rgba(#fff, .1)

  --theme-unimportant #898989
  --theme-unimportant-trans #89898966
  --theme-unimportant-2 #535353

  --theme-td-border #2b8fff
  --theme-td-hover rgba(#2b8fff, .1)

  --theme-tag-bg #1a3a5c
  --theme-tag-count-bg #15325a
  --theme-tag-border #1a3a5c

  --theme-loadingbar #fff
  --theme-loadingbar-fail #f00

  --theme-hide #000
