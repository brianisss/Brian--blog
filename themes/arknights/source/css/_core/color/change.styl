.social, #about
  text-shadow 2px 2px 4px var(--theme-text-rev)

.navBlock > .navItemTitle
  text-shadow 1px 1px 2px var(--theme-text-rev), 1px 1px 2px var(--theme-text-rev)

[theme-mode=light]
  .navItemTitle
    font-weight bold
  
  @media (min-width 769px)
    aside img:hover
      background-color var(--theme-bg-soft)

  button
    text-shadow 0 0 10px #000

  #color-mode
    @media (min-width 769px)
      &:hover::after
        transform rotate(-90deg)
    &::after
      transform rotate(-180deg)
      animation clockwise .3s
  @keyframes clockwise
    0%
      transform rotate(-270deg)
    100%
      transform rotate(-180deg)

@media (min-width 769px)
  [theme-mode=dark]
    #color-mode:hover::after
      filter invert(1)

#post-bg,
h1, h2, h3, h4, h5, h6
  transition 1s cubic-bezier(0.4, 0, 0.2, 1)
  will-change transform, opacity

@keyframes pjax-animate-in
  0%
    opacity 0
    transform translateY(10px)
  100%
    opacity 1
    transform translateY(0)

@keyframes pjax-animate-out
  0%
    opacity 1
    transform translateY(0)
  100%
    opacity 0
    transform translateY(-10px)

@property --theme-bg-trans1
  syntax '<color>'
  inherits true
  initial-value #fff

#aside-block
  transition --theme-bg-trans1 1s cubic-bezier(0.4, 0, 0.2, 1)
  will-change transform, opacity

// 淡化明暗切換時的色彩變化，背景圖片則另外交叉淡出。
body > main
  position relative
  z-index 1

.theme-background-transition
  position fixed
  inset 0
  z-index 0
  pointer-events none
  background-color var(--theme-background)
  background-attachment fixed
  background-position 50% 0
  background-repeat no-repeat
  background-size cover
  opacity 1
  transition opacity .76s cubic-bezier(.22, 1, .36, 1)
  &.is-fading
    opacity 0

html.theme-changing body,
html.theme-changing body :not(.theme-background-transition)
  transition-property color, background-color, border-color, box-shadow, text-shadow, fill, stroke !important
  transition-duration .72s !important
  transition-timing-function cubic-bezier(.22, 1, .36, 1) !important

@media (prefers-reduced-motion: reduce)
  .theme-background-transition
    transition-duration .01ms

  html.theme-changing body,
  html.theme-changing body :not(.theme-background-transition)
    transition-duration .01ms !important
