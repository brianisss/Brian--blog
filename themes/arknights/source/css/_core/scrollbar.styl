/* BA 風格捲軸美化 */
@media (min-width: 769px)
  ::-webkit-scrollbar
    width 10px
    height 10px
  ::-webkit-scrollbar-thumb
    background linear-gradient(180deg, #3b9eff, #2b8fff)
    border-radius 5px
  ::-webkit-scrollbar-track
    background #e3eefb
  ::-webkit-scrollbar-thumb:hover
    background linear-gradient(180deg, #2b8fff, #1a6fd4)

/* 全域覆蓋 */
main
  scrollbar-color var(--theme-bar-color-0) var(--theme-bar-color-2)
  scrollbar-width thin
