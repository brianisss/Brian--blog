script.
  (function () {
    var backgroundSets = !{JSON.stringify(backgroundSets)};
    var root = document.documentElement;
    function chooseBackgroundSet(animate) {
      var currentName = root.getAttribute('data-background-set');
      var candidates = animate
        ? backgroundSets.filter(function (set) { return set.name !== currentName; })
        : backgroundSets;
      var selected = candidates[Math.floor(Math.random() * candidates.length)];
      if (!selected) return;

      var transition = null;
      if (animate && document.body) {
        transition = document.createElement('div');
        transition.className = 'theme-background-transition';
        transition.style.backgroundImage = getComputedStyle(document.body).backgroundImage;
        transition.style.backgroundColor = getComputedStyle(root).getPropertyValue('--theme-background').trim();
        document.body.insertBefore(transition, document.body.firstChild);
      }

      root.style.setProperty('--light-background', "url('" + selected.light + "')");
      root.style.setProperty('--dark-background', "url('" + selected.dark + "')");
      root.setAttribute('data-background-set', selected.name);

      if (transition) {
        requestAnimationFrame(function () { transition.classList.add('is-fading'); });
        window.setTimeout(function () { transition.remove(); }, 800);
      }
    }

    chooseBackgroundSet(false);
    document.addEventListener('pjax:complete', function () { chooseBackgroundSet(true); });
  })();

