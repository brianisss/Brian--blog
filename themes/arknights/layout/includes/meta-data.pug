script.
  (function () {
    var backgroundSets = !{JSON.stringify(backgroundSets)};
    var root = document.documentElement;
    var storageKey = 'arknights-background-set-index';
    var currentIndex = 0;
    var preloadCache = Object.create(null);

    try {
      var lastIndex = parseInt(window.localStorage.getItem(storageKey), 10);
      if (!isNaN(lastIndex) && lastIndex >= 0 && lastIndex < backgroundSets.length) {
        currentIndex = lastIndex;
      }
    } catch (error) {}

    function setBackground(index) {
      var selected = backgroundSets[index];
      root.style.setProperty('--light-background', "url('" + selected.light + "')");
      root.style.setProperty('--dark-background', "url('" + selected.dark + "')");
      root.setAttribute('data-background-set', selected.name);
      try { window.localStorage.setItem(storageKey, String(index)); } catch (error) {}
    }

    function preloadImage(source) {
      return new Promise(function (resolve) {
        var image = new Image();
        var finished = false;
        function finish() {
          if (finished) return;
          finished = true;
          resolve(image);
        }
        image.decoding = 'async';
        image.onload = function () {
          if (typeof image.decode === 'function') image.decode().then(finish, finish);
          else finish();
        };
        image.onerror = finish;
        image.src = source;
        if (image.complete) {
          if (image.naturalWidth && typeof image.decode === 'function') image.decode().then(finish, finish);
          else finish();
        }
      });
    }

    function preloadSet(index) {
      if (preloadCache[index]) return preloadCache[index].promise;
      var selected = backgroundSets[index];
      var images = [selected.light, selected.dark];
      var promise = Promise.all(images.map(preloadImage));
      preloadCache[index] = { images: images, promise: promise };
      return promise;
    }

    function keepCurrentAndNextPreloaded() {
      var nextIndex = (currentIndex + 1) % backgroundSets.length;
      Object.keys(preloadCache).forEach(function (index) {
        if (Number(index) !== currentIndex && Number(index) !== nextIndex) delete preloadCache[index];
      });
      preloadSet(nextIndex);
    }

    window.advanceBackgroundSet = function () {
      var nextIndex = (currentIndex + 1) % backgroundSets.length;
      return preloadSet(nextIndex).then(function () {
        currentIndex = nextIndex;
        setBackground(currentIndex);
        keepCurrentAndNextPreloaded();
      });
    }

    setBackground(currentIndex);
    preloadSet(currentIndex);
    keepCurrentAndNextPreloaded();
  })();

