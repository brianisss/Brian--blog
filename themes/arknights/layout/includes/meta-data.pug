  const backgroundSets = []
  for (let i = 1; i <= 6; i++) {
    const setName = `set-${String(i).padStart(2, '0')}`
    backgroundSets.push({
      name: setName,
      light: url_for(`img/background-sets/${setName}/light/background.jpg`),
      dark: url_for(`img/background-sets/${setName}/dark/background.jpg`)
    })
  }

